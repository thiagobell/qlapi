{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "provider": {
    "openrouter": {
      "models": {
        "openrouter/auto": {}
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium",
        "--output-dir",
        "tmp/screenshots"
      ]
    }
  }
}
